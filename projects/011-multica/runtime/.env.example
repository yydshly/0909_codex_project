# Local-only example; launch-service.ps1 reads runtime/local/config.json.
DATABASE_URL=postgres://multica_demo@127.0.0.1:5511/multica_demo?sslmode=disable
HOST=127.0.0.1
PORT=8111
FRONTEND_PORT=3111
FRONTEND_ORIGIN=http://localhost:3111
REMOTE_API_URL=http://127.0.0.1:8111
MULTICA_APP_URL=http://localhost:3111
APP_ENV=development
JWT_SECRET=GENERATE_A_RANDOM_SECRET
MULTICA_DEV_VERIFICATION_CODE=CHOOSE_A_LOCAL_TEST_CODE
ANALYTICS_DISABLED=true
